# ============================================================
# Nabeel Astro Store — backend/server-side environment variables
# ============================================================
# Copy this file to `.env` (or set these in your host, e.g. Netlify
# Environment Variables / Vercel / your own server).
#
# IMPORTANT:
#   * Never expose secret keys, merchant passwords or private tokens
#     in public HTML/CSS/JavaScript. They live ONLY here, server-side.
#   * The frontend must only ever see PUBLIC keys (e.g. the Stripe
#     publishable key). All secret-key calls go through your backend.
#   * Placeholders below are EXAMPLES — fill with real values you get
#     from each provider's merchant dashboard.
#   * Orders are created as "Payment Pending". They may only be marked
#     "Payment Confirmed" after the gateway webhook/callback (or manual
#     owner verification) confirms the actual payment.

# ---------- EasyPaisa (Pakistan) ----------
# From your EasyPaisa merchant dashboard / account manager.
EASYPAISA_MERCHANT_ID=
EASYPAISA_API_USERNAME=
EASYPAISA_API_PASSWORD=
# Server route your backend exposes to receive EasyPaisa callbacks.
EASYPAISA_CALLBACK_URL=
EASYPAISA_WEBHOOK_SECRET=

# ---------- JazzCash (Pakistan) ----------
# From the JazzCash merchant integration portal.
JAZZCASH_MERCHANT_ID=
JAZZCASH_SALT=
JAZZCASH_API_USERNAME=
JAZZCASH_API_PASSWORD=
JAZZCASH_CALLBACK_URL=
JAZZCASH_WEBHOOK_SECRET=

# ---------- GCash / Maya / GoTyme / QR Ph (Philippines) ----------
# These are typically reached through a local aggregator/gateway.
# Replace with the credentials your chosen gateway issues.
GCASH_MERCHANT_ID=
GCASH_API_SECRET=
GCASH_CALLBACK_URL=
GCASH_WEBHOOK_SECRET=

MAYA_MERCHANT_ID=
MAYA_API_SECRET=
MAYA_CALLBACK_URL=
MAYA_WEBHOOK_SECRET=

GOTYME_MERCHANT_ID=
GOTYME_API_SECRET=
GOTYME_CALLBACK_URL=
GOTYME_WEBHOOK_SECRET=

QRPH_MERCHANT_ID=
QRPH_API_SECRET=
QRPH_CALLBACK_URL=
QRPH_WEBHOOK_SECRET=

# ---------- Stripe (International) ----------
# STRIPE_PUBLISHABLE_KEY is the ONLY value safe to ship in the frontend.
# STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET must NEVER appear in the browser.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=